+  beamPts(ctx, right, V.blue, 1.1, { hot: bright > 0.6, alpha: 0.35 + 0.65 * bright });
+  for (const q of secs) {
+    const lv = Math.pow(q.lv, 0.85);
+    const p = new Path2D();
+    p.ellipse(cx, q.y, Math.max(0.6, q.r), Math.max(0.5, q.r * 0.28), 0, 0, Math.PI * 2);
+    beam(ctx, p, heat(lv), 1, { alpha: (0.25 + 0.75 * lv) * (0.2 + 0.8 * bright) });
+  }
+}
+
+/** a fader: its track, the 0 dB and -24 dB marks, the cap at the measured level */
+function fader(ctx: CanvasRenderingContext2D, cx: number, yTop: number, yBot: number, width: number, pos: number, color: string): void {
+  seg(ctx, cx, yTop, cx, yBot, V.frame, 1.2);
+  for (const [u, len] of [[1, 0.32], [0.16, 0.22]] as const) {
+    const y = yBot - u * (yBot - yTop);
+    seg(ctx, cx - width * len, y, cx - width * len * 0.45, y, V.blueDim, 1);
+  }
