+  const cw = Math.min(26, width * 0.42), ch = 7;
+  const cap = new Path2D();
+  cap.rect(cx - cw / 2, y - ch / 2, cw, ch);
+  beam(ctx, cap, color, 1.3, { hot: true });
+  seg(ctx, cx - cw / 2 + 3, y, cx + cw / 2 - 3, y, color, 1, { alpha: 0.9 });
+}
+
+function Desk() {
+  const ref = usePhosphor(({ ctx, w, h }) => {
+    const f = M.file;
+    if (!f) return;
+    const t = M.t;
+    const vw = w * M.layout.voices;
+    const strips: { name: string; color: string; msg?: TelemetryMessage; level: number; bright: number; x: number; sw: number }[] = [];
+    if (vw > 4) {
+      const sw = vw / VOICES.length;
+      VOICES.forEach((v, i) => {
+        const level = envAt(v, t);
+        strips.push({ name: v.toUpperCase(), color: COLOR[v], msg: M.msgs.get(v), level, bright: Math.min(1, level * 1.15), x: i * sw, sw });
+      });
+    }
