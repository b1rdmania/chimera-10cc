@@ -0,0 +1,591 @@
+/**
+ * LOCAL FILM PATCH (uncommitted): `?replay=full-merged&shot=full`, the full merged film's wall.
+ * Every pane replays one voice's own recorded telemetry in its own body: the lead, its double, the
+ * high / low / octave / lift harmonies, the break's two "ooh" voices, and every pass of the
+ * tape-loop choir at its exact tape position on its real fader. The wall is a sequence of full
+ * layouts (templates); a layout changes by a clean wipe on a phrase boundary, so the frame is never
+ * half-empty. `window.__replayFull(t)` sets song time t (telemetry and layout) before each frame.
+ */
+import { useEffect, useRef, useState } from "react";
+import { engine } from "../../audio/AudioEngine.ts";
+import { useStore } from "../store.ts";
+import { TeleTrack } from "../../show/tele.ts";
+import { AnatomyView, type OverlayFn, type SlotsFn } from "./AnatomyView.tsx";
+import { Stroboscope } from "./Stroboscope.tsx";
+import { SpectrumView } from "./SpectrumView.tsx";
+import { Screen } from "./Screen.tsx";
+import { V, heat, pressureLevel } from "../colors.ts";
+import { beam, beamPts, seg, type Pt } from "../render/vector.ts";
+import { usePhosphor } from "../usePhosphor.ts";
+import { analyser, drawIpa, glyphW } from "./ReplayPage.tsx";
+import type { TelemetryMessage } from "../../worklet/protocol.ts";
+import type { BodyMix } from "../../wasm/types.ts";
+
+// ------------------------------------------------------------------ data
+interface Note {
+  midi: number;
+  t0: number;
+  t1: number;
+  show: string;
+}
+interface Pass {
+  stem: string;
+  midi: number;
+  body: "male" | "female" | "child";
+  pass: number;
+  off: number;
+}
+interface FullFile {
+  fps: number;
+  end: number;
+  pitches: { midi: number; fader: number[] }[];
+  passes: Pass[];
+  notes: Record<string, Note[]>;
+  env: Record<string, number[]>;
+  envRate: number;
+  chords: [number, number, number[]][];
+}
+const VOICES = ["lead", "double", "high", "low", "octave", "lift", "oohf", "oohc"] as const;
+type VoiceName = (typeof VOICES)[number];
+const COLOR: Record<string, string> = { lead: V.white, double: V.white, high: V.pink, low: V.green, octave: V.amber, lift: V.red, oohf: V.pink, oohc: V.amber, whisper: V.white, kick: V.red };
+const STRIPS = ["lead", "double", "high", "low", "octave", "lift", "oohf", "oohc", "whisper", "kick"];
+const W = 1920, H = 1080, GAP = 12, LOOP = 9.4, SR = 48000;
+const BODY: Record<string, BodyMix> = { male: { female: 0, child: 0 }, female: { female: 1, child: 0 }, child: { female: 0, child: 1 } };
+/** heads sized by body, as in the heads film: a female head is drawn smaller than a male, a child's smaller still */
+const BODY_SCALE: Record<string, number> = { male: 1, female: 0.84, child: 0.7 };
+
+const M = {
+  t: 0,
+  file: null as FullFile | null,
+  tracks: new Map<string, TeleTrack>(),
+  msgs: new Map<string, TelemetryMessage>(),
+  fader: new Map<number, number[]>(),
+  pass: new Map<string, Pass>(),
+  pcm: null as Float32Array | null,
+  act: 0,
+  lastT: -1,
+};
+
+const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
+const ease = (u: number) => (u <= 0 ? 0 : u >= 1 ? 1 : u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
+
+function faderAt(midi: number, t: number): number {
+  const a = M.fader.get(midi);
+  if (!a) return 0;
+  const x = t * M.file!.fps, i = Math.min(a.length - 2, Math.max(0, Math.floor(x)));
+  return a[i] + (a[i + 1] - a[i]) * clamp01(x - i);
+}
+function envAt(name: string, t: number): number {
+  const f = M.file!, a = f.env[name];
+  if (!a) return 0;
+  const x = t * f.envRate, i = Math.floor(x);
+  if (i < 0) return 0;
+  if (i >= a.length - 1) return a[a.length - 1];
+  return a[i] + (a[i + 1] - a[i]) * (x - i);
+}
+/** how far t is from the lead's singing: 0 while it sings, 1 deep in a rest */
+function leadRest(t: number): number {
+  const notes = M.file!.notes.lead;
+  let prevEnd = -Infinity, nextStart = Infinity;
+  for (const n of notes) {
+    if (n.t0 <= t && t <= n.t1) return 0;
+    if (n.t1 < t) prevEnd = n.t1;
+    else if (n.t0 > t) {
+      nextStart = n.t0;
+      break;
+    }
+  }
+  return ease(clamp01((t - prevEnd - 0.35) / 0.7)) * ease(clamp01((nextStart - t - 0.55) / 0.7));
+}
+
+// ------------------------------------------------------------------ layout: templates, tiled
+interface Rect {
+  x: number;
+  y: number;
+  w: number;
+  h: number;
+}
+type Kind = "face" | "spec" | "folds" | "desk";
+type FaceMode = "lead" | "glyph" | "plain";
+interface PaneSpec {
+  id: string;
+  kind: Kind;
+  tile: Rect;
+  voice?: string; // a voice name or a choir pass stem
+  mode?: FaceMode;
+  body?: string;
+  strips?: boolean; // desk: with the voice strips
+  dim?: boolean; // a choir face: brightness follows its fader
+}
+interface Template {
+  name: string;
+  build: (t: number) => PaneSpec[];
+}
+const R = (x: number, y: number, w: number, h: number): Rect => ({ x, y, w, h });
+/** the screens above a desk of height d */
+const topArea = (d: number) => R(10, 10, 1900, H - 20 - GAP - d);
+const deskArea = (d: number) => R(10, H - 10 - d, 1900, d);
+const face = (id: string, voice: string, tile: Rect, mode: FaceMode, body: string, dim = false): PaneSpec => ({ id, kind: "face", voice, tile, mode, body, dim });
+const bodyOf = (v: string) => (v === "high" || v === "lift" || v === "oohf" ? "female" : v === "octave" || v === "oohc" ? "child" : "male");
+
+/** split a rect into cols × rows cells with gaps */
+function cells(a: Rect, cols: number, rows: number): Rect[][] {
+  const cw = (a.w - GAP * (cols - 1)) / cols, ch = (a.h - GAP * (rows - 1)) / rows;
+  return Array.from({ length: rows }, (_, r) => Array.from({ length: cols }, (_, c) => R(a.x + c * (cw + GAP), a.y + r * (ch + GAP), cw, ch)));
+}
+const span = (g: Rect[][], c: number, r: number, w: number, h: number): Rect => {
+  const a = g[r][c], b = g[r + h - 1][c + w - 1];
+  return R(a.x, a.y, b.x + b.w - a.x, b.y + b.h - a.y);
+};
+/** a grid with some blocks placed; every other cell gets a choir pass, low pitches at the bottom */
+function mosaic(prefix: string, area: Rect, cols: number, rows: number, blocks: { voice: string; c: number; r: number; w: number; h: number; mode: FaceMode }[], choir: string[]): PaneSpec[] {
+  const g = cells(area, cols, rows);
+  const used = new Set<string>();
+  const out: PaneSpec[] = [];
+  for (const b of blocks) {
+    for (let r = b.r; r < b.r + b.h; r++) for (let c = b.c; c < b.c + b.w; c++) used.add(`${c},${r}`);
+    out.push(face(`${prefix}-${b.voice}`, b.voice, span(g, b.c, b.r, b.w, b.h), b.mode, bodyOf(b.voice)));
+  }
+  const free: Rect[] = [];
+  for (let r = rows - 1; r >= 0; r--) for (let c = 0; c < cols; c++) if (!used.has(`${c},${r}`)) free.push(g[r][c]);
+  free.forEach((cell, i) => {
+    const stem = choir[i % choir.length];
+    out.push(face(`${prefix}-c${i}`, stem, cell, "plain", M.pass.get(stem)!.body, true));
+  });
+  return out;
+}
+/** choir passes for a stretch of the song: the pitches whose faders go up in it, most-sung first, then by pitch */
+function choirFor(t0: number, t1: number, n: number, onePerPitch: boolean): string[] {
+  const f = M.file!;
+  const up = new Map<number, number>();
+  for (const [a, z, ps] of f.chords) {
+    const d = Math.min(z, t1) - Math.max(a, t0);
+    if (d > 0) for (const p of ps) up.set(p, (up.get(p) ?? 0) + d);
+  }
+  const cand = f.passes.filter((q) => up.has(q.midi) && (!onePerPitch || q.pass === 0));
+  cand.sort((a, b) => a.pass - b.pass || up.get(b.midi)! - up.get(a.midi)!);
+  return cand.slice(0, n).sort((a, b) => a.midi - b.midi || a.pass - b.pass).map((q) => q.stem);
+}
+
+function makeTemplates(): Record<string, Template> {
+  const verseDesk = (t: number) => 350 + 210 * leadRest(t);
+  const T: Record<string, Template> = {};
+  T.rack = { name: "rack", build: () => [{ id: "desk", kind: "desk", tile: R(10, 10, 1900, 1060), strips: false }] };
+  T.verse = {
+    name: "verse",
+    build: (t) => {
+      const d = verseDesk(t), top = topArea(d);
+      const rh = (top.h - GAP) / 2;
+      return [
+        face("lead", "lead", R(10, 10, 1050, top.h), "lead", "male"),
+        { id: "spec", kind: "spec", tile: R(1072, 10, 838, rh) },
+        { id: "folds", kind: "folds", tile: R(1072, 10 + rh + GAP, 838, rh) },
+        { id: "desk", kind: "desk", tile: deskArea(d), strips: true },
+      ];
+    },
+  };
+  T.lift = {
+    name: "lift",
+    build: (t) => {
+      const d = verseDesk(t), top = topArea(d);
+      const sh = Math.round(top.h * 0.38);
+      return [
+        face("lead", "lead", R(10, 10, 1050, top.h), "lead", "male"),
+        { id: "spec", kind: "spec", tile: R(1072, 10, 838, sh) },
+        face("lift", "lift", R(1072, 10 + sh + GAP, 838, top.h - sh - GAP), "glyph", "female"),
+        { id: "desk", kind: "desk", tile: deskArea(d), strips: true },
+      ];
+    },
+  };
+  T.ch1 = {
+    name: "ch1",
+    build: () => {
+      const d = 340, g = cells(topArea(d), 3, 1);
+      return [face("high", "high", g[0][0], "glyph", "female"), face("lead", "lead", g[0][1], "lead", "male"), face("low", "low", g[0][2], "glyph", "male"), { id: "desk", kind: "desk", tile: deskArea(d), strips: true }];
+    },
+  };
+  /** the lead in the middle column, two side mosaics */
+  const sides = (prefix: string, d: number, leadW: number, cols: number, rows: number, left: Parameters<typeof mosaic>[4], right: Parameters<typeof mosaic>[4], choir: string[]) => {
+    const top = topArea(d);
+    const sw = (top.w - leadW - 2 * GAP) / 2;
+    const la = R(top.x, top.y, sw, top.h), ca = R(top.x + sw + GAP, top.y, leadW, top.h), ra = R(top.x + sw + GAP + leadW + GAP, top.y, sw, top.h);
+    const nl = cols * rows - left.reduce((s, b) => s + b.w * b.h, 0), nr = cols * rows - right.reduce((s, b) => s + b.w * b.h, 0);
+    const ch = choir.length >= nl + nr ? choir : [...choir, ...choir];
+    // low pitches left, high pitches right: the left side takes the lower half of the list
+    return [
+      face(`${prefix}-lead`, "lead", ca, "lead", "male"),
+      ...mosaic(`${prefix}L`, la, cols, rows, left, ch.slice(0, nl)),
+      ...mosaic(`${prefix}R`, ra, cols, rows, right, ch.slice(nl, nl + nr)),
+      { id: `${prefix}-desk`, kind: "desk" as Kind, tile: deskArea(d), strips: true },
+    ];
+  };
+  T.ch2 = { name: "ch2", build: () => sides("ch2", 330, 640, 3, 3, [{ voice: "high", c: 1, r: 0, w: 2, h: 2, mode: "glyph" }], [{ voice: "low", c: 0, r: 0, w: 2, h: 2, mode: "glyph" }], choirFor(86.54, 100.87, 10, true)) };
+  T.ch3 = { name: "ch3", build: () => sides("ch3", 320, 640, 3, 4, [{ voice: "high", c: 1, r: 0, w: 2, h: 2, mode: "glyph" }], [{ voice: "low", c: 0, r: 0, w: 2, h: 2, mode: "glyph" }], choirFor(172.5, 183.6, 16, false)) };
+  T.bridge = {
+    name: "bridge",
+    build: () =>
+      sides(
+        "br",
+        300,
+        600,
+        4,
+        5,
+        [
+          { voice: "high", c: 2, r: 0, w: 2, h: 2, mode: "glyph" },
+          { voice: "octave", c: 2, r: 2, w: 2, h: 2, mode: "glyph" },
+        ],
+        [{ voice: "low", c: 0, r: 0, w: 2, h: 2, mode: "glyph" }],
+        choirFor(183.6, 198.3, 28, false),
+      ),
+  };
+  T.breakA = {
+    name: "breakA",
+    build: () => {
+      const d = 470, g = cells(topArea(d), 2, 1);
+      return [face("oohf", "oohf", g[0][0], "glyph", "female"), face("oohc", "oohc", g[0][1], "glyph", "child"), { id: "desk", kind: "desk", tile: deskArea(d), strips: true }];
+    },
+  };
+  T.breakB = {
+    name: "breakB",
+    build: () => {
+      const d = 330;
+      return [
+        ...mosaic(
+          "bb",
+          topArea(d),
+          6,
+          3,
+          [
+            { voice: "oohf", c: 1, r: 0, w: 2, h: 2, mode: "glyph" },
+            { voice: "oohc", c: 3, r: 0, w: 2, h: 2, mode: "glyph" },
+          ],
+          choirFor(120.4, 143.85, 10, true),
+        ),
+        { id: "desk", kind: "desk", tile: deskArea(d), strips: true },
+      ];
+    },
+  };
+  T.end = { name: "end", build: () => [{ id: "folds", kind: "folds", tile: R(10, 10, 1900, 1060) }] };
+  return T;
+}
+
+/** [time, template, wipe from the left?]: each layout change is a wipe that starts on a phrase boundary */
+const CUES: [number, string, boolean][] = [
+  [0, "rack", true],
+  [13.9, "verse", true],
+  [22.06, "lift", false],
+  [27.44, "verse", true],
+  [36.39, "lift", false],
+  [43.4, "ch1", true],
+  [57.88, "verse", false],
+  [65.05, "lift", false],
+  [70.42, "verse", true],
+  [79.38, "lift", false],
+  [86.3, "ch2", true],
+  [100.87, "breakA", false],
+  [120.4, "breakB", true],
+  [143.85, "verse", false],
+  [151.02, "lift", false],
+  [156.39, "verse", true],
+  [165.35, "lift", false],
+  [172.3, "ch3", true],
+  [182.7, "bridge", false],
+  [198.28, "verse", true],
+  [205.45, "end", false],
+];
+const WIPE = 0.95;
+
+let TEMPLATES: Record<string, Template> = {};
+
+/** the panes on screen at t: inside a wipe, the new layout left of the line and the old one right of it (or mirrored) */
+function panesAt(t: number): { key: string; spec: PaneSpec; clip: Rect }[] {
+  let i = 0;
+  while (i + 1 < CUES.length && CUES[i + 1][0] <= t) i++;
+  const [t0, name, fromLeft] = CUES[i];
+  const cur = TEMPLATES[name].build(t).map((s) => ({ key: `${name}:${s.id}`, spec: s }));
+  const u = i > 0 ? ease((t - t0) / WIPE) : 1;
+  if (u >= 1) return cur.map((p) => ({ ...p, clip: p.spec.tile }));
+  const prevName = CUES[i - 1][1];
+  const prev = TEMPLATES[prevName].build(t).map((s) => ({ key: `${prevName}:${s.id}`, spec: s }));
+  const line = fromLeft ? W * u : W * (1 - u);
+  const cut = (r: Rect, keepLeft: boolean): Rect => {
+    const x0 = keepLeft ? r.x : Math.max(r.x, line), x1 = keepLeft ? Math.min(r.x + r.w, line) : r.x + r.w;
+    return R(x0, r.y, Math.max(0, x1 - x0), r.h);
+  };
+  return [...cur.map((p) => ({ ...p, clip: cut(p.spec.tile, fromLeft) })), ...prev.map((p) => ({ ...p, clip: cut(p.spec.tile, !fromLeft) }))];
+}
+
+// ------------------------------------------------------------------ telemetry at t
+function tenorAt(t: number): Pass {
+  const f = M.file!;
+  const ch = f.chords.filter(([a]) => a <= t).pop();
+  const p = ch?.[2].find((m) => m >= 55 && m <= 59) ?? 57;
+  return f.passes.find((q) => q.midi === p && q.body === "male" && q.stem.endsWith("+0")) ?? f.passes.find((q) => q.midi === 57)!;
+}
+function replayFull(t: number): void {
+  const f = M.file;
+  if (!f) return;
+  const dt = M.lastT >= 0 && t > M.lastT ? Math.min(0.1, t - M.lastT) : 1 / 30;
+  M.lastT = t;
+  M.t = t;
+  for (const v of VOICES) {
+    const tr = M.tracks.get(v);
+    if (!tr) continue;
+    const msg = tr.message(tr.indexAt(t));
+    msg.t.clock = t;
+    M.msgs.set(v, msg);
+  }
+  for (const q of f.passes) {
+    const tr = M.tracks.get(q.stem);
+    if (!tr) continue;
+    // mix.py's tape loop: the render's 1.0–10.8 s spliced into a 9.4 s loop, started at the pass's offset
+    const lt = 1.0 + ((((q.off + t) % LOOP) + LOOP) % LOOP);
+    M.msgs.set(q.stem, tr.message(tr.indexAt(lt)));
+  }
+  const lead = M.msgs.get("lead")!;
+  let shown = lead;
+  if (t >= 205.45) {
+    // the end: the folds of the choir's tenor loop; over the last seconds the loop runs out through
+    // its own release, so the folds come to rest as the song ends
+    const q = tenorAt(t), tr = M.tracks.get(q.stem)!;
+    const lt = t < 221.6 ? 1.0 + ((((q.off + t) % LOOP) + LOOP) % LOOP) : 10.4 + ((t - 221.6) / 2.6) * 1.45;
+    shown = tr.message(tr.indexAt(lt));
+  }
+  engine.latest = shown;
+  (engine as unknown as { latestAt: number }).latestAt = performance.now();
+  analyser.pcm = M.pcm;
+  analyser.at = t * SR;
+  // the spectrum dims while the lead rests (its analyser would only show the noise floor)
+  const target = lead.t.voicing > 0.3 ? 1 : 0;
+  M.act += (target - M.act) * (1 - Math.exp(-dt / 0.2));
+
+  const on = new Set<string>();
+  for (const p of panesAt(t)) {
+    const el = document.getElementById(`fp-${p.key}`);
+    if (!el) continue;
+    const c = p.clip;
+    if (c.w < 1 || c.h < 1) continue;
+    on.add(p.key);
+    const s = p.spec, tile = s.tile;
+    Object.assign(el.style, { display: "block", left: `${c.x}px`, top: `${c.y}px`, width: `${c.w}px`, height: `${c.h}px` });
+    const frame = el.children[0] as HTMLElement, content = el.children[1] as HTMLElement;
+    Object.assign(frame.style, { left: `${tile.x - c.x}px`, top: `${tile.y - c.y}px`, width: `${tile.w}px`, height: `${tile.h}px` });
+    // a head sized by its body: inset in its tile, standing on the tile's floor
+    const k = s.kind === "face" && s.mode !== "lead" ? BODY_SCALE[s.body ?? "male"] : 1;
+    const cw = tile.w * k, chh = tile.h * k;
+    Object.assign(content.style, { left: `${tile.x + (tile.w - cw) / 2 - c.x}px`, top: `${tile.y + tile.h - chh - c.y}px`, width: `${cw}px`, height: `${chh}px` });
+    let op = 1;
+    if (s.dim && s.voice) op = 0.3 + 0.7 * faderAt(M.pass.get(s.voice)!.midi, t);
+    if (s.kind === "spec") op = 0.18 + 0.82 * M.act;
+    if (s.kind === "folds" && t > 223.4) op = clamp01((225 - t) / 1.6);
+    content.style.opacity = String(op);
+  }
+  for (const el of document.querySelectorAll<HTMLElement>(".fp-pane")) if (!on.has(el.dataset.key!)) el.style.display = "none";
+}
+
+declare global {
+  interface Window {
+    __replayFull?: (t: number) => void;
+  }
+}
+
+// ------------------------------------------------------------------ faces
+function syllableAt(notes: Note[] | undefined, t: number): { text: string; alpha: number } | null {
+  if (!notes) return null;
+  let last: Note | null = null;
+  for (const n of notes) {
+    if (n.t0 > t) break;
+    last = n;
+  }
+  if (!last) return null;
+  if (t <= last.t1) return { text: last.show, alpha: 1 };
+  const a = Math.exp(-(t - last.t1) / 0.3);
+  return a > 0.02 ? { text: last.show, alpha: a } : null;
+}
+const ascent = (s: string) => (s.includes("θ") ? 1.02 : /[bdfhklt]/.test(s) ? 0.76 : 0.52);
+const unitW = (ctx: CanvasRenderingContext2D, s: string) => [...s].reduce((acc, c) => acc + glyphW(ctx, c, 100) / 100 + 0.06, 0);
+
+/** the lead: its syllable in slot one, under the slot's label */
+function leadOverlay(voice: string): OverlayFn {
+  return (ctx, r, _m, _f, _a, { w, h }) => {
+    const s = syllableAt(M.file?.notes[voice], M.t);
+    if (!s) return;
+    const gx0 = r.X({ x: 3.35, y: 0 }), gy0 = r.Y({ x: 0, y: 2.05 });
+    const cellW = Math.max(60, (w - 14 - gx0) / 2);
+    const cellH = Math.max(56, Math.min(112, (h - 8 - gy0) / 2));
+    const big = Math.max(22, Math.min(44, cellH * 0.4, cellW * 0.32));
+    const base = gy0 + 18 + big * 1.1 + 12;
+    const size = Math.min(cellH * 0.95, (cellW - 18) / unitW(ctx, s.text), (base - gy0 - 16) / ascent(s.text));
+    drawIpa(ctx, gx0 + 2, base, s.text, size, COLOR[voice], s.alpha);
+  };
+}
+/** a harmony: its syllable in its colour, in the corner in front of the face */
+function cornerOverlay(voice: string): OverlayFn {
+  return (ctx, _r, _m, _f, _a, { w, h }) => {
+    const s = syllableAt(M.file?.notes[voice], M.t);
+    if (!s) return;
+    const size = Math.max(30, Math.min(h * 0.24, (w * 0.42) / unitW(ctx, s.text)));
+    const width = unitW(ctx, s.text) * size;
+    drawIpa(ctx, w - width - 12, h - 14, s.text, size, COLOR[voice], s.alpha);
+  };
+}
+const leadSlots: SlotsFn = (_m, a, f) => [
+  { label: "Syllable", value: "", color: V.white },
+  { label: "Jaw", value: a.jaw.toFixed(1), unit: "cm", color: V.red },
+  { label: "Lips", value: a.lipAp.toFixed(1), unit: "cm", color: V.pink },
+  f.velumPort > 0.02 ? { label: "Soft palate", value: f.velumPort.toFixed(2), unit: "cm²", color: V.white } : { label: "Soft palate", value: "Shut", color: V.white },
+];
+const none: SlotsFn = () => [];
+const noInfo = () => [];
+
+function Face(props: { voice: string; mode: FaceMode; body: string }) {
+  const v = props.voice;
+  const feed = useRef(() => M.msgs.get(v) ?? null).current;
+  const overlay = useRef(props.mode === "lead" ? leadOverlay(v) : props.mode === "glyph" ? cornerOverlay(v) : undefined).current;
+  const lead = props.mode === "lead";
+  return <AnatomyView body={BODY[props.body]} feed={feed} bare={!lead} slots={lead ? leadSlots : none} info={noInfo} showFormants={false} overlay={overlay} />;
+}
+
+// ------------------------------------------------------------------ the desk
+/** TubeView's drawing (rings sized by the area function, lit by pressure), stood upright: glottis at the bottom */
+function pipe(ctx: CanvasRenderingContext2D, msg: TelemetryMessage | undefined, cx: number, yTop: number, yBot: number, width: number, bright: number): void {
+  if (!msg) return;
+  const { phAreas: ph, orAreas: or, phLen, orLen, pressureRms: rms } = msg.t;
+  const nPh = ph.length, nOr = or.length, total = phLen + orLen;
+  const sy = (yBot - yTop) / total;
+  const dS = Math.min(width * 0.8, ((yBot - yTop) * 4) / 17) / 4;
+  const a2d = (A: number) => 2 * Math.sqrt(Math.max(0, A) / Math.PI);
+  const secs: { y: number; r: number; lv: number }[] = [];
+  for (let i = 0; i < nPh; i++) secs.push({ y: yBot - ((i + 0.5) / nPh) * phLen * sy, r: (a2d(ph[i]) * dS) / 2, lv: pressureLevel(rms[i]) });
+  for (let i = 0; i < nOr; i++) secs.push({ y: yBot - (phLen + ((i + 0.5) / nOr) * orLen) * sy, r: (a2d(or[i]) * dS) / 2, lv: pressureLevel(rms[nPh + i]) });
+  const left: Pt[] = [[cx - 2, yBot], ...secs.map((q) => [cx - q.r, q.y] as Pt), [cx - secs[secs.length - 1].r, yTop]];
+  const right: Pt[] = [[cx + 2, yBot], ...secs.map((q) => [cx + q.r, q.y] as Pt), [cx + secs[secs.length - 1].r, yTop]];
+  beamPts(ctx, left, V.blue, 1.1, { hot: bright > 0.6, alpha: 0.35 + 0.65 * bright });
+  beamPts(ctx, right, V.blue, 1.1, { hot: bright > 0.6, alpha: 0.35 + 0.65 * bright });
+  for (const q of secs) {
+    const lv = Math.pow(q.lv, 0.85);
+    const p = new Path2D();
+    p.ellipse(cx, q.y, Math.max(0.6, q.r), Math.max(0.5, q.r * 0.28), 0, 0, Math.PI * 2);
+    beam(ctx, p, heat(lv), 1, { alpha: (0.25 + 0.75 * lv) * (0.2 + 0.8 * bright) });
+  }
+}
+/** a fader: its track, the 0 dB and -24 dB marks, the cap at the level */
+function fader(ctx: CanvasRenderingContext2D, cx: number, yTop: number, yBot: number, width: number, pos: number, color: string): void {
+  seg(ctx, cx, yTop, cx, yBot, V.frame, 1.2);
+  for (const [u, len] of [[1, 0.32], [0.16, 0.22]] as const) {
+    const y = yBot - u * (yBot - yTop);
+    seg(ctx, cx - width * len, y, cx - width * len * 0.45, y, V.blueDim, 1);
+  }
+  const y = yBot - pos * (yBot - yTop);
+  const cw = Math.min(26, width * 0.5), ch = 7;
+  const cap = new Path2D();
+  cap.rect(cx - cw / 2, y - ch / 2, cw, ch);
+  beam(ctx, cap, color, 1.3, { hot: true });
+  seg(ctx, cx - cw / 2 + 3, y, cx + cw / 2 - 3, y, color, 1, { alpha: 0.9 });
+}
+function Desk(props: { strips: boolean }) {
+  const strips = props.strips;
+  const ref = usePhosphor(({ ctx, w, h }) => {
+    const f = M.file;
+    if (!f) return;
+    const t = M.t;
+    const nv = strips ? STRIPS.length : 0, np = f.pitches.length;
+    const unit = (w - (strips ? 18 : 0)) / (nv * 1.6 + np);
+    const tall = h > 600;
+    const fBot = h - 14, fTop = fBot - (tall ? h * 0.36 : h * 0.44);
+    const pBot = fTop - 14, pTop = tall ? Math.max(14, pBot - 620) : 12;
+    for (let i = 0; i < nv; i++) {
+      const name = STRIPS[i], sw = unit * 1.6, cx = i * sw + sw / 2;
+      const level = envAt(name, t);
+      if (name !== "kick" && name !== "whisper") pipe(ctx, M.msgs.get(name), cx, pTop, pBot, sw * 0.95, Math.min(1, level * 1.15));
+      fader(ctx, cx, fTop, fBot, sw, level, COLOR[name]);
+    }
+    const rx = nv * unit * 1.6 + (strips ? 18 : 0);
+    f.pitches.forEach((p, i) => {
+      const q = M.pass.get(f.passes.find((x) => x.midi === p.midi)!.stem)!;
+      const cx = rx + i * unit + unit / 2, pos = faderAt(p.midi, t);
+      pipe(ctx, M.msgs.get(q.stem), cx, pTop, pBot, unit * 0.95, pos * pos);
+      fader(ctx, cx, fTop, fBot, unit, pos, V.blue);
+    });
+  });
+  return <canvas ref={ref} className="instrument-canvas" />;
+}
+
+// ------------------------------------------------------------------ the page
+async function load(base: string): Promise<void> {
+  const get = async (p: string) => {
+    const r = await fetch(base + p);
+    if (!r.ok) throw new Error(`${p}: ${r.status}`);
+    return r.arrayBuffer();
+  };
+  const file = JSON.parse(new TextDecoder().decode(await get("full.json"))) as FullFile;
+  await Promise.all([...VOICES.map(async (v) => M.tracks.set(v, new TeleTrack(await get(`${v}.tele`)))), ...file.passes.map(async (q) => M.tracks.set(q.stem, new TeleTrack(await get(`${q.stem}.tele`))))]);
+  for (const p of file.pitches) M.fader.set(p.midi, p.fader);
+  for (const q of file.passes) M.pass.set(q.stem, q);
+  M.pcm = new Float32Array(await get("lead.f32"));
+  M.file = file;
+  TEMPLATES = makeTemplates();
+}
+
+const CSS = `
+html, body, #root { margin: 0; height: 100%; background: #000; overflow: hidden; }
+.fp { position: fixed; inset: 0; background: #000; }
+.fp-pane { position: absolute; overflow: hidden; display: none; }
+.fp-frame { position: absolute; box-sizing: border-box; border: 1px solid var(--frame); }
+.fp-frame.focus { border-color: var(--blue-dim); }
+.fp-content { position: absolute; }
+.fp-content > .anatomy { position: absolute; inset: 0; }
+.fp-content > .instrument-canvas { position: absolute; inset: 0; }
+.fp-content > .screen { position: absolute; inset: 0; border: 0; background: transparent; }
+.fp-content .screen-body { min-height: 0; }
+.fp-content .screen-head { display: none; }
+.fp-content .screen-body > .instrument-canvas { position: absolute; inset: 0; }
+`;
+
+export function FullPage(props: { id: string }) {
+  const [ready, setReady] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+  useEffect(() => {
+    useStore.setState({ started: true, mode: "play" });
+    (engine as unknown as { analyser: unknown }).analyser = analyser;
+    window.__replayFull = replayFull;
+    load(`${import.meta.env.BASE_URL}shows/${props.id}/`)
+      .then(() => setReady(true))
+      .catch((e: unknown) => setErr(String(e)));
+  }, [props.id]);
+  useEffect(() => {
+    if (!ready) return;
+    replayFull(Number(new URLSearchParams(location.search).get("t") ?? 0));
+    window.__replayReady = true;
+  }, [ready]);
+  if (err) return <p style={{ color: "#f55" }}>{err}</p>;
+  if (!ready) return null;
+  // every pane of every layout, mounted once (a pane off screen is display: none and draws nothing)
+  const all: { key: string; spec: PaneSpec }[] = [];
+  for (const [name, tp] of Object.entries(TEMPLATES)) for (const s of tp.build(0)) all.push({ key: `${name}:${s.id}`, spec: s });
+  return (
+    <div className="fp">
+      <style>{CSS}</style>
+      {all.map(({ key, spec }) => (
+        <div key={key} id={`fp-${key}`} data-key={key} className="fp-pane">
+          <div className={`fp-frame${spec.kind === "face" && spec.mode !== "plain" ? " focus" : ""}`} />
+          <div className="fp-content">
+            {spec.kind === "face" ? (
+              <Face voice={spec.voice!} mode={spec.mode!} body={spec.body!} />
+            ) : spec.kind === "desk" ? (
+              <Desk strips={!!spec.strips} />
+            ) : spec.kind === "spec" ? (
+              <Screen title="Spectrum">
+                <SpectrumView />
+              </Screen>
+            ) : (
+              <Screen title="Vocal folds" sub="Slowed 100×">
+                <Stroboscope />
+              </Screen>
+            )}
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
