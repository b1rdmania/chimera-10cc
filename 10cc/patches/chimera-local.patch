+/**
+ * LOCAL FILM PATCH (uncommitted): `?replay=<id>&shot=<wall|folds|tube>` replays recorded voice
+ * telemetry through the Play screen's own instruments (face, tube, folds, spectrum, vowels, pitch).
+ * Nothing is synthesized: `window.__replay(t)` (called by the capture script before each virtual
+ * frame) puts the recorded frame at song time t into `engine.latest`, as the worklet would, and a
+ * stand-in analyser reads the rendered voice's samples at t for the spectrum's harmonic stems.
+ *
+ * public/shows/<id>/replay.json: { leadFrom, firstChord, tenor: [[t0, t1, midi]], notes: [{midi, t0, t1, show}] }
+ * with lead.tele/lead.f32 and loop<midi>.tele/.f32 (mono float32, 48 kHz) beside it.
+ */
+import { useEffect, useState } from "react";
+import { engine } from "../../audio/AudioEngine.ts";
+import { useStore } from "../store.ts";
+import { TeleTrack } from "../../show/tele.ts";
+import { AnatomyView, type OverlayFn, type SlotsFn } from "./AnatomyView.tsx";
+import { TubeView } from "./TubeView.tsx";
+import { Stroboscope } from "./Stroboscope.tsx";
+import { SpectrumView } from "./SpectrumView.tsx";
+import { VowelMap } from "./VowelMap.tsx";
+import { PianoRoll } from "./PianoRoll.tsx";
+import { Screen } from "./Screen.tsx";
+import { roll } from "../singing.ts";
+import { V } from "../colors.ts";
+import { hfont, ipaGlyph } from "../render/vector.ts";
+
+interface Note {
+  midi: number;
+  t0: number;
+  t1: number;
+  show: string;
+}
+interface ReplayFile {
+  leadFrom: number;
+  firstChord: number;
+  tenor: [number, number, number][];
+  notes: Note[];
+}
+interface Voice {
+  track: TeleTrack;
+  pcm: Float32Array;
+}
+
+const SR = 48000;
+
+/** Web Audio's AnalyserNode, computed from a rendered voice at the replay's playhead instead of live */
+export class ReplayAnalyser {
+  readonly fftSize = 4096;
+  readonly frequencyBinCount = 2048;
+  readonly smoothingTimeConstant = 0.6;
+  pcm: Float32Array | null = null;
+  at = 0;
+  private prev = new Float32Array(2048);
+  private re = new Float64Array(4096);
+  private im = new Float64Array(4096);
+  private win = Float64Array.from({ length: 4096 }, (_, i) => {
+    const a = (2 * Math.PI * i) / 4096;
+    return 0.42 - 0.5 * Math.cos(a) + 0.08 * Math.cos(2 * a);
+  });
+  getFloatFrequencyData(out: Float32Array): void {
+    const N = this.fftSize, re = this.re, im = this.im;
+    const x = this.pcm;
+    const end = Math.floor(this.at);
+    for (let i = 0; i < N; i++) {
+      const k = end - N + i;
+      re[i] = x && k >= 0 && k < x.length ? x[k] * this.win[i] : 0;
+      im[i] = 0;
+    }
+    fft(re, im);
+    const tau = this.smoothingTimeConstant;
+    for (let k = 0; k < this.frequencyBinCount; k++) {
+      const mag = Math.hypot(re[k], im[k]) / N;
+      const s = (this.prev[k] = tau * this.prev[k] + (1 - tau) * mag);
+      out[k] = s > 0 ? 20 * Math.log10(s) : -200;
+    }
+  }
+}
+
+function fft(re: Float64Array, im: Float64Array): void {
+  const n = re.length;
+  for (let i = 1, j = 0; i < n; i++) {
+    let bit = n >> 1;
+    for (; j & bit; bit >>= 1) j ^= bit;
+    j ^= bit;
+    if (i < j) {
+      [re[i], re[j]] = [re[j], re[i]];
+      [im[i], im[j]] = [im[j], im[i]];
+    }
+  }
+  for (let len = 2; len <= n; len <<= 1) {
+    const ang = (-2 * Math.PI) / len;
+    const wr = Math.cos(ang), wi = Math.sin(ang);
+    for (let i = 0; i < n; i += len) {
+      let cr = 1, ci = 0;
+      for (let k = 0; k < len / 2; k++) {
+        const a = i + k, b = a + len / 2;
+        const tr = re[b] * cr - im[b] * ci, ti = re[b] * ci + im[b] * cr;
+        re[b] = re[a] - tr;
+        im[b] = im[a] - ti;
+        re[a] += tr;
+        im[a] += ti;
+        const nr = cr * wr - ci * wi;
+        ci = cr * wi + ci * wr;
+        cr = nr;
+      }
+    }
+  }
+}
+
+export const analyser = new ReplayAnalyser();
+const state: { t: number; file: ReplayFile | null; lead: Voice | null; loops: Map<number, Voice> } = { t: 0, file: null, lead: null, loops: new Map() };
+
+/** which recording sings at song time t, and where in it: the tenor choir loop of the chord, then the lead */
+function sourceAt(t: number): { v: Voice; lt: number } | null {
+  const f = state.file;
+  if (!f || !state.lead) return null;
+  if (t >= f.leadFrom) return { v: state.lead, lt: t };
+  const ch = f.tenor.find(([a, z]) => t >= a && t < z) ?? f.tenor[0];
+  const v = state.loops.get(ch[2]);
+  if (!v) return null;
+  // the loop's own onset on the first chord, then its steady middle, looped as the tape loop is
+  let lt = Math.max(0, t - f.firstChord);
+  if (lt > 10.4) lt = 1.0 + ((lt - 1.0) % 9.4);
+  return { v, lt };
+}
+
+/** put the recorded frame at song time t where the worklet's telemetry would go */
+function replayAt(t: number): void {
+  state.t = t;
+  const s = sourceAt(t);
+  if (!s) return;
+  const msg = s.v.track.message(s.v.track.indexAt(s.lt));
+  msg.t.clock = t;
+  engine.latest = msg;
+  (engine as unknown as { latestAt: number }).latestAt = performance.now();
+  analyser.pcm = s.v.pcm;
+  analyser.at = s.lt * SR;
+}
+
+declare global {
+  interface Window {
+    __replay?: (t: number) => void;
+    __replayReady?: boolean;
+  }
+}
+
+/** the syllable on the readout at t: lit while its note sounds, then fading like phosphor */
+function syllableAt(t: number): { text: string; alpha: number } | null {
+  const f = state.file;
+  if (!f) return null;
+  if (t < f.leadFrom) return t >= f.firstChord ? { text: "ɑ", alpha: Math.min(1, (t - f.firstChord) / 0.6) } : null;
+  let last: Note | null = null;
+  for (const n of f.notes) {
+    if (n.t0 > t) break;
+    last = n;
+  }
+  if (!last) return null;
+  if (t <= last.t1) return { text: last.show, alpha: 1 };
+  const a = Math.exp(-(t - last.t1) / 0.3);
+  return a > 0.02 ? { text: last.show, alpha: a } : null;
+}
+
+/** glyph width as ipaGlyph draws it: font letters measured, stroke vowels about half the size */
+const STROKED = new Set(["ɑ", "ɒ", "ɪ", "ɛ", "ɜ", "ɝ", "ʊ", "ʌ", "ɤ", "ʃ", "θ", "ŋ", "ə", "ɚ", "ɹ", "ʒ"]);
+export function glyphW(ctx: CanvasRenderingContext2D, ch: string, size: number): number {
+  if (STROKED.has(ch)) return size * (ch === "ŋ" || ch === "θ" ? 0.55 : 0.5);
+  ctx.save();
+  ctx.font = hfont(size);
+  const w = ctx.measureText(ch).width;
+  ctx.restore();
+  return w;
+}
+
+/** IPA a syllable at a time; the few symbols the kit lacks are drawn as strokes here */
+export function drawIpa(ctx: CanvasRenderingContext2D, x: number, y: number, text: string, size: number, color: string, alpha: number): void {
+  const chars = [...text];
+  const gap = size * 0.06;
+  const ws = chars.map((c) => glyphW(ctx, c, size));
+  let cx = x;
+  chars.forEach((c, i) => {
+    const mid = cx + ws[i] / 2;
+    const xh = size * 0.5, r = xh * 0.48, cy = y - xh / 2;
+    const stroke = (d: string) => {
+      ctx.save();
+      ctx.globalCompositeOperation = "lighter";
+      ctx.globalAlpha = alpha;
+      ctx.strokeStyle = color;
+      ctx.lineWidth = Math.max(0.9, size * 0.07);
+      ctx.lineCap = "round";
+      ctx.lineJoin = "round";
+      ctx.stroke(new Path2D(d));
+      ctx.restore();
+    };
+    if (c === "ɚ") {
+      ipaGlyph(ctx, mid, y, "ə", size, color, alpha);
+      stroke(`M${mid + r * 0.85} ${cy - xh * 0.15}Q${mid + r * 1.5} ${cy - xh * 0.55} ${mid + r * 1.6} ${cy - xh * 0.2}`);
+    } else if (c === "ɹ") {
+      stroke(`M${mid + r * 0.7} ${y - xh}L${mid + r * 0.7} ${y}M${mid + r * 0.7} ${y - xh * 0.4}Q${mid} ${y + xh * 0.05} ${mid - r * 0.8} ${y - xh * 0.15}`);
+    } else if (c === "ʒ") {
+      stroke(`M${mid - r} ${y - xh}L${mid + r} ${y - xh}L${mid - r * 0.1} ${cy}Q${mid + r * 1.2} ${cy} ${mid + r * 0.9} ${y + xh * 0.35}Q${mid + r * 0.4} ${y + xh * 0.95} ${mid - r} ${y + xh * 0.6}`);
+    } else if (/[a-z]/.test(c)) {
+      // a Hershey letter, thickened to the stroke weight of the drawn IPA vowels beside it
+      ctx.save();
+      ctx.globalCompositeOperation = "lighter";
+      ctx.globalAlpha = alpha;
+      ctx.font = hfont(size);
+      ctx.textAlign = "center";
+      ctx.fillStyle = ctx.strokeStyle = color;
+      ctx.lineWidth = size * 0.05;
+      ctx.lineJoin = ctx.lineCap = "round" as CanvasLineJoin & CanvasLineCap;
+      ctx.fillText(c, mid, y);
+      ctx.strokeText(c, mid, y);
+      ctx.restore();
+    } else ipaGlyph(ctx, mid, y, c, size, color, alpha);
+    cx += ws[i] + gap;
+  });
+}
+
+/** where drawReadouts puts the slot grid (same arithmetic), so the syllable lands in slot one */
+const syllableOverlay: OverlayFn = (ctx, r, _m, _f, _a, { w, h }) => {
+  const s = syllableAt(state.t);
+  if (!s) return;
+  const gx0 = r.X({ x: 3.35, y: 0 }), gy0 = r.Y({ x: 0, y: 2.05 });
+  const cellW = Math.max(60, (w - 14 - gx0) / 2);
+  const cellH = Math.max(56, Math.min(112, (h - 8 - gy0) / 2));
+  const big = Math.max(22, Math.min(44, cellH * 0.4, cellW * 0.32));
+  // as big as slot one holds: its cell's height, and its width up to the next slot
+  const unit = [...s.text].reduce((acc, c) => acc + glyphW(ctx, c, 100) / 100 + 0.06, 0);
+  const size = Math.min(cellH * 0.95, (cellW - 18) / unit);
+  drawIpa(ctx, gx0 + 2, gy0 + 18 + big * 1.1 + size * 0.12, s.text, size, V.green, s.alpha);
+};
+
+/** Play's slots, with the first one holding the syllable being sung */
+const replaySlots: SlotsFn = (_m, a, f) => [
+  { label: "Syllable", value: "", color: V.green },
+  { label: "Jaw", value: a.jaw.toFixed(1), unit: "cm", color: V.red },
+  { label: "Lips", value: a.lipAp.toFixed(1), unit: "cm", color: V.pink },
+  f.velumPort > 0.02 ? { label: "Soft palate", value: f.velumPort.toFixed(2), unit: "cm²", color: V.white } : { label: "Soft palate", value: "Shut", color: V.white },
+];
+const noInfo = () => [];
+
+async function load(base: string): Promise<void> {
+  const get = async (p: string) => {
+    const r = await fetch(base + p);
+    if (!r.ok) throw new Error(`${p}: ${r.status}`);
+    return r.arrayBuffer();
+  };
+  const file = JSON.parse(new TextDecoder().decode(await get("replay.json"))) as ReplayFile;
+  const voice = async (stem: string): Promise<Voice> => ({ track: new TeleTrack(await get(stem + ".tele")), pcm: new Float32Array(await get(stem + ".f32")) });
+  state.lead = await voice("lead");
+  for (const p of new Set(file.tenor.map((c) => c[2]))) state.loops.set(p, await voice(`loop${p}`));
+  state.file = file;
+  roll.notes = file.notes.map((n) => ({ midi: n.midi, t0: n.t0, t1: n.t1, text: "", demo: false }));
+}
+
+const CSS = `
+html, body, #root { margin: 0; height: 100%; background: #000; overflow: hidden; }
+.rp-solo { position: fixed; inset: 0; background: #000; }
+.rp-wall { position: fixed; inset: 0; padding: 10px; box-sizing: border-box; display: grid; gap: 12px; grid-template-columns: minmax(0, 700fr) minmax(0, 696fr); background: #000; }
+.rp-right { display: grid; gap: 12px; min-height: 0; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr); grid-template-areas: "tube folds" "spec spec" "vowels roll"; }
+.rp-right .screen-body { min-height: 0; }
+.rp-right .roll-canvas, .rp-right .vowel-map { height: 100%; min-height: 0; position: absolute; inset: 0; }
+.rp-tube { grid-area: tube; } .rp-folds { grid-area: folds; } .rp-spec { grid-area: spec; } .rp-vowels { grid-area: vowels; } .rp-roll { grid-area: roll; }
+.rp-right .instrument-canvas { position: absolute; inset: 0; }
+`;
+
+export function ReplayPage(props: { id: string; shot: string }) {
+  const [ready, setReady] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+  useEffect(() => {
+    useStore.setState({ started: true, mode: "play" });
+    (engine as unknown as { analyser: unknown }).analyser = analyser;
+    window.__replay = replayAt;
+    load(`${import.meta.env.BASE_URL}shows/${props.id}/`)
+      .then(() => {
+        replayAt(Number(new URLSearchParams(location.search).get("t") ?? 0));
+        setReady(true);
+        window.__replayReady = true;
+      })
+      .catch((e: unknown) => setErr(String(e)));
+  }, [props.id]);
+  if (err) return <p style={{ color: "#f55" }}>{err}</p>;
+  if (!ready) return null;
+  return (
+    <>
+      <style>{CSS}</style>
+      {props.shot === "folds" ? (
+        <div className="rp-solo">
+          <Stroboscope />
+        </div>
+      ) : props.shot === "tube" ? (
+        <div className="rp-solo">
+          <TubeView />
+        </div>
+      ) : (
+        <div className="rp-wall">
+          <Screen className="left" focus label="Live vocal tract">
+            <AnatomyView slots={replaySlots} info={noInfo} overlay={syllableOverlay} />
+          </Screen>
+          <div className="rp-right">
+            <Screen className="rp-tube" title="Tube" sub="Glottis to lips">
+              <TubeView />
+            </Screen>
+            <Screen className="rp-folds" title="Vocal folds" sub="Slowed 100×">
+              <Stroboscope />
+            </Screen>
+            <Screen className="rp-spec" title="Spectrum">
+              <SpectrumView />
+            </Screen>
+            <Screen className="rp-vowels" title="Vowels" sub="F1 / F2">
+              <VowelMap />
+            </Screen>
+            <Screen className="rp-roll" title="Pitch">
+              <PianoRoll />
+            </Screen>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
