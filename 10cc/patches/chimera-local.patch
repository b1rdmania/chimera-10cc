+  for (let i = 0; i < nPh; i++) secs.push({ y: yBot - ((i + 0.5) / nPh) * phLen * sy, r: (a2d(ph[i]) * dS) / 2, lv: pressureLevel(rms[i]) });
+  for (let i = 0; i < nOr; i++) secs.push({ y: yBot - (phLen + ((i + 0.5) / nOr) * orLen) * sy, r: (a2d(or[i]) * dS) / 2, lv: pressureLevel(rms[nPh + i]) });
+  const left: Pt[] = [[cx - 2, yBot], ...secs.map((q) => [cx - q.r, q.y] as Pt), [cx - secs[secs.length - 1].r, yTop]];
+  const right: Pt[] = [[cx + 2, yBot], ...secs.map((q) => [cx + q.r, q.y] as Pt), [cx + secs[secs.length - 1].r, yTop]];
