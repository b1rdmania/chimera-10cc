+/**
+ * LOCAL FILM PATCH (uncommitted): `?replay=merged&shot=merged`, the merged film's one wall.
+ * Every voice replays its own recorded telemetry: the lead (face, spectrum, folds), the double,
+ * the high / low / lift harmonies (their own faces, in their own bodies), and the tape-loop choir
+ * (one tube per pitch, at its exact tape position, on its real fader). The wall's layout is a
+ * function of song time: panels slide, split and resize on phrase boundaries.
+ * `window.__replayMerged(t)` sets song time t (telemetry and layout) before each virtual frame.
+ */
+import { useEffect, useRef, useState } from "react";
+import { engine } from "../../audio/AudioEngine.ts";
+import { useStore } from "../store.ts";
+import { TeleTrack } from "../../show/tele.ts";
+import { AnatomyView, type OverlayFn, type SlotsFn } from "./AnatomyView.tsx";
+import { Stroboscope } from "./Stroboscope.tsx";
+import { SpectrumView } from "./SpectrumView.tsx";
+import { Screen } from "./Screen.tsx";
+import { V, TEXT, heat, pressureLevel } from "../colors.ts";
+import { beam, beamPts, label, seg, type Pt } from "../render/vector.ts";
+import { usePhosphor } from "../usePhosphor.ts";
+import { analyser, drawIpa, glyphW } from "./ReplayPage.tsx";
+import type { TelemetryMessage } from "../../worklet/protocol.ts";
+import type { BodyMix } from "../../wasm/types.ts";
+
+interface Note {
+  midi: number;
+  t0: number;
+  t1: number;
+  show: string;
+}
+interface Pipe {
+  midi: number;
+  stem: string;
+  off: number;
+  loopLen: number;
+  fader: number[];
+}
+interface MergedFile {
+  fps: number;
+  choir: Pipe[];
+  notes: Record<string, Note[]>;
+  env: Record<string, number[]>;
+  envRate: number;
+  regions: Record<string, [number, number][]>;
+}
+
+const VOICES = ["lead", "double", "high", "low", "lift"] as const;
+type VoiceName = (typeof VOICES)[number];
+const COLOR: Record<VoiceName, string> = { lead: V.white, double: V.white, high: V.pink, low: V.green, lift: V.red };
+const NAMES = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"];
+const W = 1920, H = 1080;
+
+const M: {
+  t: number;
+  file: MergedFile | null;
+  tracks: Map<string, TeleTrack>;
+  msgs: Map<string, TelemetryMessage>;
+  pcm: Float32Array | null;
+  layout: Layout;
+} = { t: 0, file: null, tracks: new Map(), msgs: new Map(), pcm: null, layout: null as unknown as Layout };
+
+// ------------------------------------------------------------------ layout over song time
+interface Rect {
+  x: number;
+  y: number;
+  w: number;
+  h: number;
+}
+type PanelId = "lead" | "high" | "low" | "lift" | "spec" | "folds" | "desk";
+/** a panel: the window it shows through (clip), and where its screen sits (content). A panel
+ *  appears or leaves by its window opening or closing over a screen that stays put, so nothing is
+ *  squeezed; only the lead face and the desk really change size. */
+interface Pane {
+  clip: Rect;
+  content: Rect;
+}
+interface Layout {
+  p: Record<PanelId, Pane>;
+  /** share of the desk's width given to the voice strips (the rest is the choir rack) */
+  voices: number;
+}
+const R = (x: number, y: number, w: number, h: number): Rect => ({ x, y, w, h });
+const shown = (r: Rect): Pane => ({ clip: r, content: r });
+const closed = (content: Rect, side: "l" | "r" | "mid"): Pane => ({
+  clip: side === "l" ? R(content.x, content.y, 0, content.h) : side === "r" ? R(content.x + content.w, content.y, 0, content.h) : R(content.x, content.y + content.h / 2, content.w, 0),
+  content,
+});
+const LEAD_V = R(10, 10, 1050, 742), SPEC = R(1072, 10, 838, 365), FOLDS = R(1072, 387, 838, 365), LIFTR = FOLDS;
+const HIGH_C = R(10, 10, 626, 690), LEAD_C = R(648, 10, 624, 690), LOW_C = R(1284, 10, 626, 690);
+const BAND = R(10, 764, 1900, 306), BAND_C = R(10, 712, 1900, 358), FULL = R(10, 10, 1900, 1060);
+const VERSE: Layout = {
+  p: { lead: shown(LEAD_V), high: closed(HIGH_C, "l"), low: closed(LOW_C, "r"), lift: closed(R(1072, 312, 838, 440), "l"), spec: shown(SPEC), folds: shown(FOLDS), desk: shown(BAND) },
+  voices: 0.3,
+};
+const INTRO: Layout = { p: { ...VERSE.p, lead: closed(LEAD_V, "mid"), spec: closed(SPEC, "r"), folds: closed(FOLDS, "r"), desk: shown(FULL) }, voices: 0 };
+const WAKE: Layout = { ...INTRO, p: { ...INTRO.p, desk: shown(BAND) }, voices: 0.3 };
+const LIFT: Layout = { p: { ...VERSE.p, spec: shown(R(1072, 10, 838, 290)), folds: closed(FOLDS, "r"), lift: shown(R(1072, 312, 838, 440)) }, voices: 0.3 };
+const CHORUS: Layout = {
+  p: { ...VERSE.p, high: shown(HIGH_C), lead: shown(LEAD_C), low: shown(LOW_C), spec: closed(SPEC, "r"), folds: closed(FOLDS, "r"), desk: shown(BAND_C) },
+  voices: 0.3,
+};
+type Timing = Partial<Record<PanelId, [number, number]>>;
+/** [start, layout, seconds, per-panel share of the move]: each change starts on a phrase boundary */
+const CUES: [number, Layout, number, Timing][] = [
+  [0, INTRO, 0, {}],
+  [12.66, WAKE, 1.3, {}],
+  [13.9, VERSE, 1.3, { spec: [0.25, 1], folds: [0.35, 1] }],
+  [22.06, LIFT, 1.2, { spec: [0, 0.4], folds: [0, 0.55], lift: [0.3, 1] }],
+  [27.44, VERSE, 1.2, { lift: [0, 0.55], spec: [0.5, 1], folds: [0.3, 1] }],
+  [36.39, LIFT, 1.2, { spec: [0, 0.4], folds: [0, 0.55], lift: [0.3, 1] }],
+  [41.76, VERSE, 1.2, { lift: [0, 0.55], spec: [0.5, 1], folds: [0.3, 1] }],
+  [43.36, CHORUS, 1.7, { spec: [0, 0.45], folds: [0, 0.45], lead: [0.15, 1], high: [0.35, 1], low: [0.4, 1] }],
+  [57.88, VERSE, 1.7, { high: [0, 0.6], low: [0, 0.6], lead: [0.1, 0.9], spec: [0.5, 1], folds: [0.55, 1] }],
+];
+const ease = (u: number) => (u <= 0 ? 0 : u >= 1 ? 1 : u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
+const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
+const lerpR = (a: Rect, b: Rect, u: number): Rect => ({ x: lerp(a.x, b.x, u), y: lerp(a.y, b.y, u), w: lerp(a.w, b.w, u), h: lerp(a.h, b.h, u) });
+function layoutAt(t: number): Layout {
+  let prev = CUES[0][1], cur = CUES[0][1], f = 1, timing: Timing = {};
+  for (let i = 1; i < CUES.length; i++) {
+    const [t0, l, d, tm] = CUES[i];
+    if (t < t0) break;
+    prev = cur;
+    cur = l;
+    f = (t - t0) / d;
+    timing = tm;
+  }
+  const p = {} as Record<PanelId, Pane>;
+  for (const k of Object.keys(cur.p) as PanelId[]) {
+    const [s0, s1] = timing[k] ?? [0, 1];
+    const u = ease((f - s0) / (s1 - s0));
+    p[k] = { clip: lerpR(prev.p[k].clip, cur.p[k].clip, u), content: lerpR(prev.p[k].content, cur.p[k].content, u) };
+  }
+  return { p, voices: lerp(prev.voices, cur.voices, ease(f)) };
+}
+
+// ------------------------------------------------------------------ telemetry at t
+function replayMerged(t: number): void {
+  M.t = t;
+  const f = M.file;
+  if (!f) return;
+  for (const v of VOICES) {
+    const tr = M.tracks.get(v);
+    if (!tr) continue;
+    const msg = tr.message(tr.indexAt(t));
+    msg.t.clock = t;
+    M.msgs.set(v, msg);
+  }
+  for (const p of f.choir) {
+    const tr = M.tracks.get(p.stem);
+    if (!tr) continue;
+    // mix.py's tape loop: the render's 1.0–10.8 s, spliced into a 9.4 s loop, started at its offset
+    const lt = 1.0 + ((((p.off + t) % p.loopLen) + p.loopLen) % p.loopLen);
+    M.msgs.set(p.stem, tr.message(tr.indexAt(lt)));
+  }
+  const lead = M.msgs.get("lead");
+  if (lead) {
+    engine.latest = lead;
+    (engine as unknown as { latestAt: number }).latestAt = performance.now();
+  }
+  analyser.pcm = M.pcm;
+  analyser.at = t * 48000;
+  M.layout = layoutAt(t);
+  for (const id of Object.keys(M.layout.p) as PanelId[]) {
+    const el = document.getElementById(`mp-${id}`);
+    const inner = el?.firstElementChild as HTMLElement | null;
+    if (!el || !inner) continue;
+    const { clip: c, content: q } = M.layout.p[id];
+    el.style.display = c.w < 1 || c.h < 1 ? "none" : "";
+    Object.assign(el.style, { left: `${c.x}px`, top: `${c.y}px`, width: `${c.w}px`, height: `${c.h}px` });
+    Object.assign(inner.style, { left: `${q.x - c.x}px`, top: `${q.y - c.y}px`, width: `${q.w}px`, height: `${q.h}px` });
+  }
+}
+
+declare global {
+  interface Window {
+    __replayMerged?: (t: number) => void;
+  }
+}
+
+/** a 10 Hz level from film/env.json at t */
+function envAt(name: string, t: number): number {
+  const f = M.file;
+  const a = f?.env[name];
+  if (!a) return 0;
+  const x = t * f!.envRate, i = Math.floor(x);
+  if (i < 0) return 0;
+  if (i >= a.length - 1) return a[a.length - 1];
+  return a[i] + (a[i + 1] - a[i]) * (x - i);
+}
+function faderAt(p: Pipe, t: number): number {
+  const fps = M.file!.fps, x = t * fps, i = Math.min(p.fader.length - 2, Math.max(0, Math.floor(x)));
+  return p.fader[i] + (p.fader[i + 1] - p.fader[i]) * Math.min(1, Math.max(0, x - i));
+}
+
+// ------------------------------------------------------------------ the faces
+function syllableAt(notes: Note[], t: number): { text: string; alpha: number } | null {
+  let last: Note | null = null;
+  for (const n of notes) {
+    if (n.t0 > t) break;
+    last = n;
+  }
+  if (!last) return null;
+  if (t <= last.t1) return { text: last.show, alpha: 1 };
+  const a = Math.exp(-(t - last.t1) / 0.3);
+  return a > 0.02 ? { text: last.show, alpha: a } : null;
+}
+/** the tallest stroke above the baseline, as a share of the glyph size */
+const ascent = (s: string) => (s.includes("θ") ? 1.02 : /[bdfhklt]/.test(s) ? 0.76 : 0.52);
+
+function syllableOverlay(voice: VoiceName): OverlayFn {
+  return (ctx, r, _m, _f, _a, { w, h }) => {
+    const notes = M.file?.notes[voice];
+    const s = notes && syllableAt(notes, M.t);
+    if (!s) return;
+    const gx0 = r.X({ x: 3.35, y: 0 }), gy0 = r.Y({ x: 0, y: 2.05 });
+    const cellW = Math.max(60, (w - 14 - gx0) / 2);
+    const cellH = Math.max(56, Math.min(112, (h - 8 - gy0) / 2));
+    const big = Math.max(22, Math.min(44, cellH * 0.4, cellW * 0.32));
+    const base = gy0 + 18 + big * 1.1 + 12;
+    const unit = [...s.text].reduce((acc, c) => acc + glyphW(ctx, c, 100) / 100 + 0.06, 0);
+    // as big as slot one holds: under its label, and up to the next slot
+    const size = Math.min(cellH * 0.95, (cellW - 18) / unit, (base - gy0 - 16) / ascent(s.text));
+    drawIpa(ctx, gx0 + 2, base, s.text, size, COLOR[voice], s.alpha);
+  };
+}
+function slotsFor(voice: VoiceName): SlotsFn {
+  return (_m, a, f) => [
+    { label: voice === "lead" ? "Syllable" : `${voice} · syllable`, value: "", color: COLOR[voice] },
+    { label: "Jaw", value: a.jaw.toFixed(1), unit: "cm", color: V.red },
+    { label: "Lips", value: a.lipAp.toFixed(1), unit: "cm", color: V.pink },
+    f.velumPort > 0.02 ? { label: "Soft palate", value: f.velumPort.toFixed(2), unit: "cm²", color: V.white } : { label: "Soft palate", value: "Shut", color: V.white },
+  ];
+}
+const noInfo = () => [];
+
+function Face(props: { voice: VoiceName; body: BodyMix }) {
+  const v = props.voice;
+  const feed = useRef(() => M.msgs.get(v) ?? null).current;
+  const overlay = useRef(syllableOverlay(v)).current;
+  const slots = useRef(slotsFor(v)).current;
+  return (
+    <div id={`mp-${v}`} className="mp-clip">
+      <div className="mp-inner">
+        <section className="screen focus" aria-label={`${v} voice`}>
+          <div className="screen-body">
+            <AnatomyView body={props.body} feed={feed} slots={slots} info={noInfo} overlay={overlay} />
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+}
+
+// ------------------------------------------------------------------ the desk: a strip per voice, a rack of tape loops
+/** TubeView's drawing (rings sized by the area function, lit by pressure), stood upright: glottis at the bottom */
+function pipe(ctx: CanvasRenderingContext2D, msg: TelemetryMessage | undefined, cx: number, yTop: number, yBot: number, width: number, bright: number): void {
+  if (!msg) return;
+  const { phAreas: ph, orAreas: or, phLen, orLen, pressureRms: rms } = msg.t;
+  const nPh = ph.length, nOr = or.length, total = phLen + orLen;
+  const sy = (yBot - yTop) / total;
+  const dS = Math.min(width * 0.8, ((yBot - yTop) * 4) / 17) / 4; // true proportions, up to 80% of the strip
+  const a2d = (A: number) => 2 * Math.sqrt(Math.max(0, A) / Math.PI);
