+      strips.push({ name: `${NAMES[p.midi % 12]}${Math.floor(p.midi / 12) - 1}`, color: V.blue, msg: M.msgs.get(p.stem), level: pos, bright: pos * pos, x: rx + i * sw, sw });
+    });
