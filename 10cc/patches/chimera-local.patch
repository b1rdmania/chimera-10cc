+      fader(ctx, cx, fTop, fBot, s.sw, s.level, s.color);
+      label(ctx, s.name, cx, labelY, { size: s.sw < 70 ? 8 : 9, color: s.color === V.blue ? TEXT.secondary : s.color, align: "center", ls: 0.12, alpha: 0.75 });
+    }
+  });
+  return (
+    <div id="mp-desk" className="mp-clip">
+      <div className="mp-inner">
+        <section className="screen" aria-label="Desk">
+          <div className="screen-body">
+            <canvas ref={ref} className="instrument-canvas" />
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+}
+
+// ------------------------------------------------------------------ the page
+async function load(base: string): Promise<void> {
+  const get = async (p: string) => {
+    const r = await fetch(base + p);
+    if (!r.ok) throw new Error(`${p}: ${r.status}`);
+    return r.arrayBuffer();
+  };
+  const file = JSON.parse(new TextDecoder().decode(await get("merged.json"))) as MergedFile;
+  for (const v of VOICES) M.tracks.set(v, new TeleTrack(await get(`${v}.tele`)));
+  for (const p of file.choir) M.tracks.set(p.stem, new TeleTrack(await get(`${p.stem}.tele`)));
+  M.pcm = new Float32Array(await get("lead.f32"));
+  M.file = file;
+}
+
+const CSS = `
+html, body, #root { margin: 0; height: 100%; background: #000; overflow: hidden; }
+.mp { position: fixed; inset: 0; background: #000; }
+.mp-clip { position: absolute; overflow: hidden; }
+.mp-inner { position: absolute; }
+.mp-inner > .screen { position: absolute; inset: 0; box-sizing: border-box; }
+.mp-inner > .screen > .screen-body { position: absolute; inset: 0; min-height: 0; }
+.mp-titled > .screen > .screen-body { position: relative; inset: auto; flex: 1 1 auto; }
+.mp-inner .instrument-canvas { position: absolute; inset: 0; }
+`;
+
+export function MergedPage(props: { id: string }) {
+  const [ready, setReady] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+  useEffect(() => {
+    useStore.setState({ started: true, mode: "play" });
+    (engine as unknown as { analyser: unknown }).analyser = analyser;
+    window.__replayMerged = replayMerged;
+    load(`${import.meta.env.BASE_URL}shows/${props.id}/`)
+      .then(() => {
+        M.layout = layoutAt(0);
+        setReady(true);
+      })
+      .catch((e: unknown) => setErr(String(e)));
+  }, [props.id]);
+  useEffect(() => {
+    if (!ready) return;
+    replayMerged(Number(new URLSearchParams(location.search).get("t") ?? 0));
+    window.__replayReady = true;
+  }, [ready]);
+  if (err) return <p style={{ color: "#f55" }}>{err}</p>;
+  if (!ready) return null;
+  const body = (v: VoiceName) => M.tracks.get(v)!.body;
+  return (
+    <div className="mp">
+      <style>{CSS}</style>
+      <Desk />
+      <Face voice="high" body={body("high")} />
+      <Face voice="low" body={body("low")} />
+      <Face voice="lead" body={body("lead")} />
+      <Face voice="lift" body={body("lift")} />
+      <div id="mp-spec" className="mp-clip">
+        <div className="mp-inner mp-titled">
+          <Screen title="Spectrum">
+            <SpectrumView />
+          </Screen>
+        </div>
+      </div>
+      <div id="mp-folds" className="mp-clip">
+        <div className="mp-inner mp-titled">
+          <Screen title="Vocal folds" sub="Slowed 100×">
+            <Stroboscope />
+          </Screen>
+        </div>
+      </div>
+    </div>
+  );
+}
